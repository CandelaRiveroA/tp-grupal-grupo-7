/*
 * Hoja de estilos global del cliente.
 *
 * Los estilados se limitan a selectores con objectName: una regla sin id
 * alcanza a todas las instancias del widget y cambia el look de las
 * demás pantallas. La familia "StardewValley" es registrada por
 * Application en el arranque (recursos del qrc).
 */

QLabel#codePrompt {
    color: #4a1808;
    font-family: "StardewValley";
    font-size: 26px;
}

QLineEdit#codeInput {
    color: #3b170c;
    background: transparent;
    border: none;
    font-family: "StardewValley";
    font-size: 26px;
}

QLabel#screenStatus {
    color: #fff0ba;
    font-family: "StardewValley";
    font-size: 26px;
}
